generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth tables ───
// Managed by better-auth. Field mapping is configured in src/server/lib/auth.ts
// (e.g. better-auth's "image" field maps to our "avatarUrl" column).

/// The app user. One per person, regardless of how they log in.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  alias         String?   /// Short display name (preferred over name in the UI)
  emailVerified Boolean   @default(false)
  avatarUrl     String?   /// Profile picture URL (from Google OAuth)
  locale        String    @default("en") /// Preferred language ("en" or "fr")
  theme         String    @default("parchment") /// Preferred theme ("parchment" or "candlelit")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  createdMatches      Match[]            @relation("MatchCreator")
  createdShareTokens  MatchShareToken[]  @relation("ShareTokenCreator")

  // Profiles owned by this user (i.e. people they've added).
  ownedProfiles  Profile[]      @relation("ProfileOwner")
  // Profiles linked to this auth account. Includes the user's own
  // self-Profile (auto-created on first login) and any profile that a
  // friend has linked to this account via QR (Phase 6-C). Multiple
  // friends can independently maintain their own linked Profile for
  // the same person — uniqueness is per-owner, not global.
  linkedProfiles Profile[]      @relation("ProfileLinked")
}

/// An OAuth provider link. One User can have multiple Accounts
/// (e.g. Google today, other providers in the future).
/// Stores provider-specific tokens and credentials.
model Account {
  id                    String    @id @default(cuid())
  accountId             String    /// Provider-side user ID (e.g. Google user ID)
  providerId            String    /// Auth provider name (e.g. "google", "credential")
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   /// OAuth access token
  refreshToken          String?   /// OAuth refresh token
  idToken               String?   /// OAuth ID token (JWT with user claims)
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   /// OAuth scopes granted
  password              String?   /// Hashed password (email/password auth in test mode)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// An active login session. Created on sign-in, deleted on sign-out.
/// The token is sent as an httpOnly cookie.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique /// Session token stored in the browser cookie
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Used by better-auth for email verification and password reset flows.
model Verification {
  id         String    @id @default(cuid())
  identifier String    /// What is being verified (e.g. email address)
  value      String    /// Verification token or code
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ─── Application tables ───

/// A board game template (seeded, not user-created).
/// Each game defines its scoring rules in the config JSON field.
model Game {
  id          String  @id @default(cuid())
  slug        String  @unique /// URL-friendly identifier (e.g. "7-wonders-duel")
  name        String
  description String
  minPlayers  Int
  maxPlayers  Int
  iconUrl     String?
  config      Json    @default("{}") /// Game-specific scoring config (categories, rules, variants)

  matches Match[]
}

/// A game session between players. Created when someone starts a new game.
model Match {
  id          String    @id @default(cuid())
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id])
  createdById String
  createdBy   User      @relation("MatchCreator", fields: [createdById], references: [id])
  status      String    @default("IN_PROGRESS") /// "IN_PROGRESS" or "COMPLETED"
  victoryType String?   /// How the game ended (e.g. "score", "military_supremacy")
  winnerId    String?   /// References Player.id (not a FK to avoid circular deps)
  metadata    Json      @default("{}") /// Game-specific match settings (e.g. { skullKing: { dealerStart: 0 } })
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt /// Drives Last-Write-Wins merging during pull-sync
  completedAt DateTime?

  players     Player[]
  scores      Score[]
  shareToken  MatchShareToken?
}

/// Public read-only share link for a completed match (PR 8-D).
/// One token per Match; owner creates it from the match-complete
/// screen, can revoke at any time. The token is the URL slug for
/// `GET /api/share/:token` (public, no auth) and `/share/:token`
/// (public client route + OG meta SSR for chat-app unfurls).
model MatchShareToken {
  id          String   @id @default(cuid()) /// Used as the URL token.
  matchId     String   @unique
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdById String   /// The User who minted the token (must own / have created the match).
  createdBy   User     @relation("ShareTokenCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdById])
}

/// A participant in a match. Always points to a Profile (the domain
/// entity for "the person who played"). Identity, display name, and
/// linked-User attribution all flow through `profile` — there is no
/// denormalized snapshot on the Player row. After PR 6-C's
/// single-Profile refactor, Player.userId / Player.name (legacy
/// columns from 6-A) are gone; the only join key is `profileId`.
model Player {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  profileId String  /// The person who played.
  profile   Profile @relation(fields: [profileId], references: [id])
  position  Int     /// Seat/turn order (0-indexed)
  updatedAt DateTime @updatedAt

  scores Score[]

  @@unique([matchId, position])
  @@index([profileId])
}

// ─── Phase 6: Profile entities ───
//
// Profile is the **domain person** as the app sees them, decoupled from
// the auth User row. Profiles can be:
//   - **unclaimed** (`linkedUserId IS NULL`): owner-only visibility, owner
//     edits name + avatar freely.
//   - **linked** (`linkedUserId IS NOT NULL`): visible to both the owner
//     and the linked auth user. Owner still edits display fields; the
//     linked user's own `User.avatarUrl` / `User.name` remain authoritative
//     when `useLinkedAvatar` is true.
// A self-Profile is auto-created on first login (ownerId = linkedUserId =
// self.id) so the user appears in their own suggestions list.

/// A person as the app sees them. Always owned by a User; optionally
/// linked to an auth account (which makes matches mutually visible).
model Profile {
  id              String   @id @default(cuid())
  ownerId         String   /// The User who created this Profile.
  linkedUserId    String?  /// Set when bound to an auth account. Uniqueness is per-owner (see `@@unique` below) so different owners can each maintain their own linked Profile for the same friend; an owner can hold at most one linked Profile per friend.
  alias           String   /// Primary display name. Owner-editable even when linked.
  customAvatarUrl String?  /// Owner-uploaded avatar (ships in 6-B).
  useLinkedAvatar Boolean  @default(true) /// When linked: prefer linkedUser.avatarUrl over customAvatarUrl.
  /// Stamp frame shape: "circle" | "rounded" | "tag". Applies to the
  /// rendered avatar (photo OR initial fallback) on every consumer.
  /// Owner-controlled; viewer-invariant.
  avatarFrame     String   @default("circle")
  /// Stamp colour ring: one of the 8 category keys (civil,
  /// scientific, commercial, guilds, progress, treasury, military,
  /// wonders) or null for no ring. Stored as a key (not hex) so the
  /// rendered colour re-themes between Parchment and Candlelit.
  avatarRing      String?
  usedAt          DateTime @default(now()) /// Bumped on each match create; drives suggestion ordering.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner      User     @relation("ProfileOwner",  fields: [ownerId],      references: [id], onDelete: Cascade)
  linkedUser User?    @relation("ProfileLinked", fields: [linkedUserId], references: [id], onDelete: SetNull)
  players    Player[]

  @@unique([ownerId, linkedUserId])
  @@index([ownerId])
  @@index([linkedUserId])
}

/// A single score entry for a player in a match.
/// One entry per player per scoring category (e.g. "military", "round_3").
model Score {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category String /// Scoring category (e.g. "military", "civil", "round_1")
  value    Int    /// Calculated score for this category
  metadata Json   @default("{}") /// Extra data (e.g. { bid, tricks, bonusDetails[] } for Skull King)
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId, category])
}

/// Server-side telemetry for terminally-failed client sync queue entries
/// (Phase 8-E). Each row is a single failed entry that a client reported
/// after its retry budget was exhausted. Used to spot real-world stall
/// patterns ahead of PR 8-F's recovery fix without waiting for users to
/// open Settings → Sync on their own device.
///
/// Server-only — never exposed via a public API. The retention model is
/// indefinite for now (volume is tiny: friend-circle scale). Drop the
/// table during Phase 8-F clean-up once the recovery model lands.
model SyncFailureLog {
  id           String   @id @default(cuid())
  userId       String?  /// May be null for an entry reported pre-auth.
  method       String   /// HTTP method of the failed request (POST, PATCH, …).
  url          String   /// Request URL (no querystring or PII).
  status       Int?     /// HTTP status of the server response, if any.
  errorMessage String?  /// `errorBody.error` from the server, or the local fallback.
  errorField   String?  /// `errorBody.field`, if the server pointed at one.
  errorHint    String?  /// `errorBody.hint`, if the server supplied one.
  retries      Int      @default(0)
  /// Wall-clock ISO timestamp captured by the *client* when it gave up.
  /// Kept separately from `reportedAt` because the client may report a
  /// batch of older failures on a reconnect.
  clientFailedAt String?
  reportedAt   DateTime @default(now())

  @@index([reportedAt])
}
