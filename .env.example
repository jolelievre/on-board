DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onboard_dev"
PORT=3000

# Auth
BETTER_AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:5173"

# Google OAuth (get credentials at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth (get credentials at https://developers.facebook.com)
# The Facebook app's Privacy URL must point to /privacy on the deploy
# before Meta will let the app leave Development mode.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Any provider whose vars are missing/blank is silently disabled — the
# login page reads /api/auth/providers and only renders enabled buttons.
