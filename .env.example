DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onboard_dev"
PORT=3000

# Auth
BETTER_AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:5173"

# Google OAuth (get credentials at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth (get credentials at https://developers.facebook.com)
# The Facebook app's Privacy URL must point to /privacy on the deploy
# before Meta will let the app leave Development mode.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Apple Sign-In (Apple Developer Program required)
# - APPLE_CLIENT_ID: the Services ID identifier (e.g. com.example.signin)
# - APPLE_TEAM_ID: 10-character team id from developer.apple.com
# - APPLE_KEY_ID: 10-character key id from the Sign in with Apple key
# - APPLE_PRIVATE_KEY: the .p8 file content (ECDSA P-256), including the
#   -----BEGIN PRIVATE KEY----- header. To paste a multi-line PEM into a
#   single env var, replace newlines with the literal string `\n` and the
#   server will normalise them, OR set it via the Coolify multi-line var
#   editor which preserves real newlines.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Any provider whose vars are missing/blank is silently disabled — the
# login page reads /api/auth/providers and only renders enabled buttons.
